{
  "name": "haisailocal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "prisma generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:seed": "node --env-file=.env.local --import tsx prisma/seed.ts",
    "db:studio": "node --env-file=.env.local node_modules/prisma/build/index.js studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/outfit": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.186.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  }
}
